JWT_SECRET=
LOGFLARE_API_PORT=80
LOGFLARE_API_ROOT_PATH=
LOGFLARE_DATABASE_URL=sqlite+aiosqlite:///db/mydb.sqlite
LOGFLARE_LOG_ROOTS=/logs,../logs,logs
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
SUPERUSER_NAME=admin
SUPERUSER_PASSWORD=
FCM_KEY_FILE=/path/to/your/fcm_key_file.json
FCM_GOOGLE_FILE=/path/to/your/google-services.json
# 허용할 로그인 방식: password(비밀번호), access(Cloudflare Access) 를 쉼표로.
# 비우면(기본) 예전과 같다: password 는 항상 켜고, 아래 Access 설정 셋이 모두 있으면 access 도 켠다.
# 값을 쓰면 그 목록만 켠다 (access 를 끄려면 access 를 뺀 값을 쓴다). 꺼진 방식의 로그인 엔드포인트는 404, 이미 발급된 토큰은 그대로 동작.
# 쓸 수 있는 방식이 하나도 없는 값이면 기동 시 ERROR 로그를 남기고 새 로그인이 모두 막힌다.
# 업그레이드: 명시하지 않으면 예전과 같다. 앱은 GET /user/auth/modes 로 켜진 방식을 확인한다.
LOGFLARE_AUTH_MODES=
# Cloudflare Access 로그인 (POST /user/auth/access). 셋 다 채우면 켜진다 (LOGFLARE_AUTH_MODES 를 명시했다면 access 도 포함해야 함). 아니면 404.
# 팀 도메인 (예: myteam.cloudflareaccess.com), Access 애플리케이션의 AUD 태그, '신원=사용자명' 쉼표 구분
# 신원은 서비스 토큰 common_name 또는 이메일 (예: abc123.access=admin,me@example.com=admin)
LOGFLARE_ACCESS_TEAM_DOMAIN=
LOGFLARE_ACCESS_AUD=
LOGFLARE_ACCESS_USERS=
